# Build output — the server rebuilds it from source on every deploy.
site/dist/

# Raw photography and design working files (~100 MB). The frames that are
# actually used are committed, already processed, under site/public/assets/img.
Images/
Images2/
Images3/
Images4/
ratzon-law/
kling_*.png

# Generator source PNGs must never ship with the site (they are 1–3 MB each and
# have repeatedly been swept into deploys). Only the processed webp/jpg belong
# in public; the single legitimate PNG is whitelisted below.
site/public/assets/img/**/*.png
!site/public/assets/img/apple-touch-icon.png

# Tooling scratch
node_modules/
.impeccable/
.agents/
site/.unlazy/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Agent tooling and raw client notes — neither is needed to build or serve the
